// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// We now store `role` as a plain String instead of an enum,
// and `services` as a single String (e.g. "general,malaria,antenatal").
// This keeps SQLite happy.

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  phoneNumber  String?
  passwordHash String
  role         String   @default("user") // "admin" | "chw" | "user"
  channel      String? // preferred reminder channel
  language     String? // "English", "Kinyarwanda", etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reminders Reminder[]
}

model Clinic {
  id           Int      @id @default(autoincrement())
  name         String
  address      String?
  area         String?
  latitude     Float?
  longitude    Float?
  openingHours String?
  services     String? // e.g. "general,malaria,antenatal"
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes     ClinicNote[]
  reminders Reminder[]   @relation("ClinicReminders")
}

model ClinicNote {
  id        Int      @id @default(autoincrement())
  clinicId  Int
  author    String?
  role      String?  @default("chw")
  content   String
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

model Reminder {
  id           Int      @id @default(autoincrement())
  userId       Int
  clinicId     Int?
  type         String   @default("visit") // e.g. "visit" | "medication"
  channel      String   @default("SMS")
  scheduledFor DateTime
  status       String   @default("pending") // "pending" | "sent" | "failed" | "cancelled"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  clinic Clinic? @relation("ClinicReminders", fields: [clinicId], references: [id])
}
